	<string>Atom Health reads your weight, workouts, activity and nutrition from Apple Health so your AtomHealth Mac app can use them.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Atom Health writes weights and meals logged in AtomHealth into Apple Health.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
