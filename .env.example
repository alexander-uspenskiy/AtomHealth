# Copy to .env and adjust. Local Qwen service (llama-server, OpenAI-compatible API).
LLM_BASE_URL=http://127.0.0.1:8082/v1
LLM_MODEL=qwen3.8-27b-uncensored
LLM_API_KEY=local

# LLM_TIMEOUT=180

# Telegram bot (from @BotFather) and the chat IDs allowed to use it (comma-separated)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=

# Optional app settings
# ATOMHEALTH_DATA_DIR=./data
# WEIGHT_DB=./data/weight.db
